import express from "express";
import cors from "cors";
import helmet from "helmet";
import dotenv from "dotenv";
import jwt from "jsonwebtoken";
import argon2 from "argon2";
import { Pool } from "pg";

dotenv.config();
const app = express();
app.use(cors());
app.use(helmet());
app.use(express.json());

const pool = new Pool({ connectionString: process.env.DATABASE_URL });
const JWT_SECRET = process.env.JWT_SECRET || "secret";

// Health check
app.get("/health", (_, res) => res.json({ ok: true }));

// Auth
app.post("/auth/login", async (req, res) => {
  const { email, password } = req.body;
  const user = await pool.query("SELECT * FROM users WHERE email=$1", [email]);
  if (!user.rows.length) return res.status(401).json({ error: "Invalid credentials" });
  const valid = await argon2.verify(user.rows[0].password, password);
  if (!valid) return res.status(401).json({ error: "Invalid credentials" });
  const token = jwt.sign({ id: user.rows[0].id, role: user.rows[0].role }, JWT_SECRET);
  res.json({ token });
});

// Example balance
app.get("/students/:id/balance", async (req, res) => {
  const { id } = req.params;
  const result = await pool.query("SELECT COALESCE(SUM(amount),0) as balance FROM payments WHERE student_id=$1", [id]);
  res.json({ balance: result.rows[0].balance });
});

const port = 4000;
app.listen(port, () => console.log(`Backend running on http://localhost:${port}`));
